# The site's name, language and time zone come from ../site/site.json (site/README.md). The three settings of
# the same kind here are used only when there is no such file. APP_NAME also names the session cookie.
APP_NAME="Liga Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# The holidays a new database starts with (config/ptsite.php). Empty: the holiday table starts empty.
PTSITE_HOLIDAY_PRESET=sao-paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The MySQL server of compose.yaml (`task db:up`). A git worktree gets a database of its own, such as ptsite_100,
# from `task worktree:init`. The tests add a suffix to this name: ptsite_test, ptsite_e2e_phone.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ptsite
DB_USERNAME=root
DB_PASSWORD=root
# A prefix for every table name, such as liga_, so two sites can share one database. Empty: no prefix.
DB_TABLE_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The image software that makes the player photos: gd or imagick (docs/decisions/0016-server-side-player-photos.md).
IMAGE_DRIVER=gd
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail goes to Mailpit (compose.yaml): read it at http://127.0.0.1:8025. Production values: docs/architecture/deployment.md.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
