APP_NAME="Clube Exemplo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# This site's settings (config/ptsite.php in the package).
PTSITE_TAGLINE="O menor site feito com o PTSite"
PTSITE_HOLIDAY_PRESET=sao-paulo

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ptsite_example
DB_USERNAME=root
DB_PASSWORD=root
DB_TABLE_PREFIX=ex_

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
IMAGE_DRIVER=gd

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"
