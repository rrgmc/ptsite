{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ptsite/example-site",
    "type": "project",
    "description": "The smallest site built on the PTSite package",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../../backend"
        }
    ],
    "require": {
        "php": "^8.3",
        "rrgmc/ptsite": "@dev"
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
